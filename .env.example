# API do backend (GoTrue + PostgREST auto-hospedados, protocolo do Supabase).
# Produção: https://pmoc-api.server247.com.br. Também aceita um projeto Supabase hospedado.
NEXT_PUBLIC_SUPABASE_URL=https://pmoc-api.server247.com.br
# chave pública "anon" — no servidor: PMOC_ANON_KEY em ~/docker/.env
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# chave service_role — no servidor: PMOC_SERVICE_ROLE_KEY em ~/docker/.env.
# Usada só no servidor (admin, audit log, ART, logins do portal). Ignora RLS.
# NUNCA exponha no browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# seu(s) e-mail(is) de dono do SaaS — dá acesso a /admin (assinantes e
# mensalidades). Separe por vírgula se for mais de uma pessoa.
PLATFORM_ADMIN_EMAILS=voce@seudominio.com

# opcional — Cloudflare Turnstile (CAPTCHA no login/cadastro). Ver SECURITY-SETUP.md.
# Com esta variável presente, o captcha passa a ser obrigatório.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
